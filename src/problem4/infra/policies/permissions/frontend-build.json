{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>/frontend/*"
      ]
    },
    {
      "Sid": "WriteOwnBuildRecords",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<MANIFEST_BUCKET>/builds/frontend/*"
      ]
    },
    {
      "Sid": "CheckExistingArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>/frontend/*"
      ]
    },
    {
      "Sid": "ReadOwnBuildRecords",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::<MANIFEST_BUCKET>/builds/frontend/*"
      ]
    }
  ]
}
