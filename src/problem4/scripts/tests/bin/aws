#!/usr/bin/env bash
set -uo pipefail

: "${FAKE_AWS_STATE:?}"
: "${FAKE_AWS_LOG:?}"
service="${1:-}"
op="${2:-}"
shift 2 || true
printf '%s %s %s\n' "$service" "$op" "$*" >> "$FAKE_AWS_LOG"

arg() {
  local name="$1" prev="" a
  for a in "${ARGS[@]+"${ARGS[@]}"}"; do
    if [ "$prev" = "$name" ]; then printf '%s' "$a"; return 0; fi
    prev="$a"
  done
  return 1
}
has_flag() {
  local a
  for a in "${ARGS[@]+"${ARGS[@]}"}"; do [ "$a" = "$1" ] && return 0; done
  return 1
}
ARGS=("$@")

fail_if_injected() {
  local s o sub target
  [ -n "${FAKE_AWS_FAIL:-}" ] || return 0
  target="$(arg --key || arg --copy-source || arg --paths || true)"
  while IFS=' ' read -r s o sub; do
    [ -n "$s" ] || continue
    if [ "$s" = "$service" ] && [ "$o" = "$op" ]; then
      if [ -z "${sub:-}" ] || case "$target" in *"$sub"*) true ;; *) false ;; esac; then
        echo "An error occurred (InternalError) when calling the $op operation: injected failure" >&2
        exit 254
      fi
    fi
  done <<< "$(printf '%s\n' "$FAKE_AWS_FAIL" | tr ';' '\n')"
}
fail_if_injected

b64sum() { python3 -I -c 'import base64, hashlib, sys; print(base64.b64encode(hashlib.sha256(open(sys.argv[1], "rb").read()).digest()).decode())' "$1"; }
obj() { printf '%s/s3/%s/%s' "$FAKE_AWS_STATE" "$1" "$2"; }
meta() { printf '%s/meta/%s/%s.json' "$FAKE_AWS_STATE" "$1" "$2"; }

write_object() {
  local bucket="$1" key="$2" src="$3" cache="$4" ctype="$5" o m version
  o="$(obj "$bucket" "$key")"
  m="$(meta "$bucket" "$key")"
  mkdir -p "$(dirname "$o")" "$(dirname "$m")"
  cp "$src" "$o"
  version="v$(date +%s)$RANDOM"
  jq -n --arg c "$(b64sum "$o")" --arg cc "$cache" --arg ct "$ctype" --arg v "$version" \
    '{ChecksumSHA256: $c, CacheControl: $cc, ContentType: $ct, VersionId: $v, ETag: "\"etag\""}' > "$m"
  cat "$m"
}

case "$service $op" in
  "s3api put-object")
    bucket="$(arg --bucket)"; key="$(arg --key)"; body="$(arg --body)"
    if has_flag --if-none-match && [ -e "$(obj "$bucket" "$key")" ]; then
      echo "An error occurred (PreconditionFailed) when calling the PutObject operation: At least one of the pre-conditions you specified did not hold" >&2
      exit 254
    fi
    write_object "$bucket" "$key" "$body" "$(arg --cache-control || true)" "$(arg --content-type || true)"
    ;;
  "s3api head-object")
    bucket="$(arg --bucket)"; key="$(arg --key)"
    if [ ! -e "$(obj "$bucket" "$key")" ]; then echo "An error occurred (404) when calling the HeadObject operation: Not Found" >&2; exit 254; fi
    cat "$(meta "$bucket" "$key")"
    ;;
  "s3api get-object")
    bucket="$(arg --bucket)"; key="$(arg --key)"; out="${ARGS[${#ARGS[@]}-1]}"
    if [ ! -e "$(obj "$bucket" "$key")" ]; then echo "An error occurred (NoSuchKey) when calling the GetObject operation" >&2; exit 254; fi
    cp "$(obj "$bucket" "$key")" "$out"
    cat "$(meta "$bucket" "$key")"
    ;;
  "s3api copy-object")
    bucket="$(arg --bucket)"; key="$(arg --key)"; source="$(arg --copy-source)"
    sb="${source%%/*}"; sk="${source#*/}"
    if [ ! -e "$(obj "$sb" "$sk")" ]; then echo "An error occurred (NoSuchKey) when calling the CopyObject operation" >&2; exit 254; fi
    tmp="$(mktemp)"; cp "$(obj "$sb" "$sk")" "$tmp"
    write_object "$bucket" "$key" "$tmp" "$(arg --cache-control || true)" "$(arg --content-type || jq -r '.ContentType' "$(meta "$sb" "$sk")")" > /dev/null
    rm -f "$tmp"
    echo '{"CopyObjectResult": {}}'
    ;;
  "s3api list-objects-v2")
    bucket="$(arg --bucket)"; prefix="$(arg --prefix || true)"
    root="$FAKE_AWS_STATE/s3/$bucket"
    if [ -d "$root" ]; then
      (cd "$root" && find . -type f | sed 's#^\./##' | sort) | awk -v p="$prefix" 'index($0, p) == 1' | jq -R . | jq -s '{Contents: map({Key: .})}'
    else
      echo '{"Contents": []}'
    fi
    ;;
  "s3api delete-object")
    bucket="$(arg --bucket)"; key="$(arg --key)"
    rm -f "$(obj "$bucket" "$key")" "$(meta "$bucket" "$key")"
    echo '{}'
    ;;
  "cloudfront create-invalidation")
    echo '{"Invalidation": {"Id": "IFAKE1", "Status": "InProgress"}}'
    ;;
  "cloudfront wait")
    [ "${FAKE_INVALIDATION_WAIT:-ok}" = "ok" ] || { echo "Waiter InvalidationCompleted failed" >&2; exit 255; }
    ;;
  "deploy create-deployment")
    count=$(( $(grep -c '^deploy create-deployment' "$FAKE_AWS_LOG") ))
    echo "{\"deploymentId\": \"d-FAKE$count\"}"
    ;;
  "deploy wait")
    count=$(( $(grep -c '^deploy wait' "$FAKE_AWS_LOG") ))
    outcome="$(printf '%s' "${FAKE_DEPLOY_WAIT:-ok}" | cut -d' ' -f"$count")"
    [ "${outcome:-ok}" = "ok" ] || { echo "Waiter DeploymentSuccessful failed: Max attempts exceeded" >&2; exit 255; }
    ;;
  "deploy list-deployment-targets")
    echo '{"targetIds": ["i-0001", "i-0002"]}'
    ;;
  "deploy batch-get-deployment-targets")
    count=$(( $(grep -c '^deploy batch-get-deployment-targets' "$FAKE_AWS_LOG") ))
    statuses="$(printf '%s' "${FAKE_TARGET_STATUSES:-Succeeded,Succeeded}" | cut -d' ' -f"$count")"
    [ -n "$statuses" ] || statuses="Succeeded,Succeeded"
    printf '%s' "$statuses" | tr ',' '\n' | jq -R . | jq -s '{deploymentTargets: [to_entries[] | {instanceTarget: {targetId: ("i-000" + ((.key + 1) | tostring)), status: .value}}]}'
    ;;
  "elbv2 describe-target-health")
    count=$(( $(grep -c '^elbv2 describe-target-health' "$FAKE_AWS_LOG") ))
    states="$(printf '%s' "${FAKE_TARGET_HEALTH:-healthy,healthy}" | cut -d' ' -f"$count")"
    [ -n "$states" ] || states="healthy,healthy"
    printf '%s' "$states" | tr ',' '\n' | jq -R . | jq -s '{TargetHealthDescriptions: [.[] | {TargetHealth: {State: .}}]}'
    ;;
  *)
    echo "fake aws: unsupported call $service $op" >&2
    exit 2
    ;;
esac
