{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>",
        "arn:aws:s3:::<ARTIFACT_BUCKET>/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyUnconditionalWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<ARTIFACT_BUCKET>/*",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      }
    },
    {
      "Sid": "DenyDeletes",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>",
        "arn:aws:s3:::<ARTIFACT_BUCKET>/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::<DELIVERY_ACCOUNT_ID>:role/retention-admin"
        }
      }
    },
    {
      "Sid": "CrossAccountRead",
      "Effect": "Allow",
      "Principal": {
        "AWS": [
          "arn:aws:iam::<STAGING_ACCOUNT_ID>:role/backend-staging-deploy",
          "arn:aws:iam::<PRODUCTION_ACCOUNT_ID>:role/backend-production-deploy",
          "arn:aws:iam::<STAGING_ACCOUNT_ID>:role/frontend-staging-deploy",
          "arn:aws:iam::<PRODUCTION_ACCOUNT_ID>:role/frontend-production-deploy",
          "arn:aws:iam::<STAGING_ACCOUNT_ID>:role/backend-instance",
          "arn:aws:iam::<PRODUCTION_ACCOUNT_ID>:role/backend-instance"
        ]
      },
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes"
      ],
      "Resource": "arn:aws:s3:::<ARTIFACT_BUCKET>/*"
    }
  ]
}
