{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectAttributes"
      ],
      "Resource": [
        "arn:aws:s3:::<ARTIFACT_BUCKET>/backend/*"
      ]
    },
    {
      "Sid": "ReadRecords",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<MANIFEST_BUCKET>",
        "arn:aws:s3:::<MANIFEST_BUCKET>/*"
      ]
    },
    {
      "Sid": "WriteOwnRecords",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::<MANIFEST_BUCKET>/production/backend/*"
      ]
    },
    {
      "Sid": "DeployOneGroup",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment",
        "codedeploy:GetDeployment",
        "codedeploy:ListDeploymentTargets",
        "codedeploy:BatchGetDeploymentTargets",
        "codedeploy:GetDeploymentConfig",
        "codedeploy:RegisterApplicationRevision",
        "codedeploy:GetApplicationRevision"
      ],
      "Resource": [
        "arn:aws:codedeploy:<REGION>:<PRODUCTION_ACCOUNT_ID>:deploymentgroup:backend/backend-production",
        "arn:aws:codedeploy:<REGION>:<PRODUCTION_ACCOUNT_ID>:application:backend",
        "arn:aws:codedeploy:<REGION>:<PRODUCTION_ACCOUNT_ID>:deploymentconfig:CodeDeployDefault.OneAtATime"
      ]
    },
    {
      "Sid": "ReadTargetHealth",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
