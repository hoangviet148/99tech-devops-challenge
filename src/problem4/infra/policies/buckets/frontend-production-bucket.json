{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>",
        "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    },
    {
      "Sid": "DenyUnconditionalWrites",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Condition": {
        "Null": {
          "s3:if-none-match": "true"
        },
        "Bool": {
          "s3:ObjectCreationOperation": "true"
        }
      },
      "NotResource": [
        "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>/index.html"
      ]
    },
    {
      "Sid": "CloudFrontRead",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>",
        "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>/*"
      ],
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::<PRODUCTION_ACCOUNT_ID>:distribution/<DISTRIBUTION_ID_PRODUCTION>"
        }
      }
    },
    {
      "Sid": "DenyDeletesOutsideCleanup",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<FRONTEND_BUCKET_PRODUCTION>/*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::<PRODUCTION_ACCOUNT_ID>:role/frontend-asset-cleanup"
        }
      }
    }
  ]
}
