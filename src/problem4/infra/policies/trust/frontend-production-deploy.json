{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubOidc",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::<PRODUCTION_ACCOUNT_ID>:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:<OWNER>@<OWNER_ID>/<REPO>@<REPO_ID>:environment:frontend-production:job_workflow_ref:<OWNER>/<REPO>/.github/workflows/_deploy-frontend.yml@refs/heads/main"
        }
      }
    }
  ]
}
